// Prisma schema for selfOS
// See SPEC_SERVER.md §4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  emailVerified DateTime?

  profile       Profile?
  settings      Settings?
  projects      Project[]
  daily         DailyVlog[]
  knowledge     Knowledge[]
  refreshTokens RefreshToken[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  userId         String    @id
  fullName       String
  dateOfBirth    DateTime?
  address        String?
  email          String
  phone          String?
  occupation     String?
  bio            String?
  avatarUrl      String?
  avatarPublicId String?
  coverUrl       String?
  coverPublicId  String?
  socialLinks    Json?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime  @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  userId          String
  slug            String
  name            String
  summary         String?
  content         Json
  contentHtml     String?
  coverUrl        String?
  coverPublicId   String?
  startDate       DateTime?
  endDate         DateTime?
  teamSize        Int?
  technologies    String[]
  results         String?
  revenueAmount   Decimal?  @db.Decimal(14, 2)
  revenueCurrency String?
  client          String?
  role            String?
  links           Json?
  gallery         Json?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, isPublished])
}

model DailyVlog {
  id          String    @id @default(cuid())
  userId      String
  slug        String
  title       String
  content     Json
  contentHtml String?
  coverUrl    String?
  videos      Json?
  images      Json?
  tags        String[]
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, publishedAt])
}

model Knowledge {
  id                  String    @id @default(cuid())
  userId              String
  slug                String
  title               String
  content             Json
  contentHtml         String?
  method              String?
  source              String?
  startedAt           DateTime?
  completedAt         DateTime?
  certificateUrl      String?
  certificatePublicId String?
  images              Json?
  tags                String[]
  isPublished         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model Settings {
  userId            String   @id
  theme             String   @default("system")
  accentColor       String?
  layout            String   @default("grid")
  modulesVisibility Json
  seo               Json?
  customDomain      String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
